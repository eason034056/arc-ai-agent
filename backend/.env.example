# ========================================
# GENERAL SETTINGS
# ========================================

# Application environment: dev, staging, or production
# - dev: Development with debug logging
# - staging: Pre-production testing
# - production: Production deployment
ENV=dev

# Timezone for scheduled jobs (e.g., America/Chicago, Asia/Taipei, UTC)
# Used by the scheduler to run payroll at specific times
TZ=America/Chicago


# ========================================
# DATABASE CONFIGURATION
# ========================================

# PostgreSQL database connection URL
# Format: postgresql+psycopg2://user:password@host:port/database
# Example: postgresql+psycopg2://user:pass@localhost:5432/arc_payroll
DATABASE_URL=postgresql+psycopg2://user:pass@postgres:5432/arc_payroll

# Redis cache connection URL
# Format: redis://host:port/database
REDIS_URL=redis://redis:6379/0


# ========================================
# SLACK CONFIGURATION
# ========================================

# Slack bot OAuth token (starts with xoxb-)
# Get from: https://api.slack.com/apps > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack signing secret for request verification
# Get from: https://api.slack.com/apps > Basic Information
SLACK_SIGNING_SECRET=your-signing-secret-here

# Slack channel ID for payroll approval messages
# Right-click channel > View channel details > Copy ID
# Leave empty to disable Slack notifications
SLACK_APPROVAL_CHANNEL=C01234567890


# ========================================
# BLOCKCHAIN CONFIGURATION
# ========================================

# Arc Testnet RPC endpoint
# This is where all blockchain transactions are sent
ARC_RPC_URL=https://arc-testnet-rpc-url-here

# Operator account private key (with or without 0x prefix)
# SECURITY WARNING: Never commit this value! Keep it secret!
# This account must have OPERATOR_ROLE in the PayrollVault contract
PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Deployed PayrollVault contract address on Arc Testnet
PAYROLL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Path to PayrollVault ABI JSON file
# Default path works for Docker container
PAYROLL_CONTRACT_ABI_PATH=/app/abi/PayrollVault.json

# USDC token decimal places (standard USDC uses 6 decimals)
# 1 USDC = 1,000,000 smallest units
USDC_DECIMALS=6

# USDC token contract address (leave empty if not needed)
USDC_ADDRESS=


# ========================================
# AI / LLM CONFIGURATION
# ========================================

# OpenAI API key for anomaly detection (starts with sk-)
# Optional: System works without AI features if not provided
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use for AI features
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4


# ========================================
# EXPENSE SYSTEM INTEGRATION
# ========================================

# External expense system webhook URL
# Optional: Leave empty if no external expense system
# Transaction results will be sent to this URL
EXPENSE_WEBHOOK_URL=

# Authentication token for expense system webhook
# Optional: Leave empty if webhook doesn't require authentication
EXPENSE_WEBHOOK_TOKEN=


# ========================================
# PAYROLL POLICIES
# ========================================

# Maximum number of recipients per blockchain transaction
# Smaller = more reliable, Larger = more efficient
# Recommended: 50-100
BATCH_SIZE=50

# How long to wait for approval before auto-rejection (in minutes)
# After this time, the batch is automatically rejected
APPROVAL_TIMEOUT_MINUTES=120

# Anomaly detection sensitivity (0.0 to 1.0)
# Higher = stricter (more items flagged as anomalies)
# Lower = more permissive (fewer items flagged)
ANOMALY_THRESHOLD=0.7


# ========================================
# API CONFIGURATION
# ========================================

# Host to bind the API server
# Use 0.0.0.0 to accept connections from any network interface
API_HOST=0.0.0.0

# Port to bind the API server
API_PORT=8080

# Secret key for JWT tokens and session management
# IMPORTANT: Change this to a random string in production!
# Generate with: openssl rand -hex 32
API_SECRET_KEY=change-this-secret-key-in-production

# Allowed CORS origins (comma-separated list)
# Add your frontend URL here
# Example: http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000


# ========================================
# LOGGING CONFIGURATION
# ========================================

# Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for development, INFO for production
LOG_LEVEL=INFO

# Log output format
# Options: json (structured logging), text (human-readable)
# Use json for production, text for development
LOG_FORMAT=json
